{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vertex",
  "version": "0.1.0",
  "identifier": "com.vertex.converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Vertex",
        "width": 480,
        "height": 480,
        "resizable": true,
        "minimizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "shadow": false,
        "dragDropEnabled": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNkUxMTY4NDVEQzNBNTIKUldSU090eEZhQkZ1LzJhS1hDaHpxRFdoSGdnVm5DSE5PMU56eXVDTzlzMzl0Ylp3cEVXZDFqZ3YK",
      "endpoints": [
        "https://github.com/rainaku/Vertex/releases/latest/download/latest.json"
      ]
    }
  }
}
